rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user is the curator/admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'blessing.waydiva@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Entitlements: Server-authoritative, ordinary users cannot modify
    match /entitlements/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // Payment Records: Read by purchaser or admin, write only by admin/server
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // AI Quota & Fair-Use Tracking
    match /aiUsage/{usageId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // User profile document and personal cooking journal
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      // Users cannot directly grant themselves premium in profile; entitlement is server-controlled
      allow update: if isAdmin() || (
        isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['entitlement']) ||
          request.resource.data.entitlement == resource.data.entitlement
        )
      );
      allow delete: if isOwner(userId) || isAdmin();

      // Scoped Subcollections
      match /favorites/{recipeId} {
        allow read, write: if isOwner(userId);
      }

      match /cookingHistory/{historyId} {
        allow read, write: if isOwner(userId);
      }

      match /passport/{countryCode} {
        allow read, write: if isOwner(userId);
      }

      match /shoppingList/{itemId} {
        allow read, write: if isOwner(userId);
      }

      match /downloads/{recipeId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Premium Reviewer Requests
    match /premiumRequests/{requestId} {
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Recipe question insights (aggregated & curated)
    match /recipeInsights/{recipeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Rate limits (tracking for serverless AI endpoints)
    match /rateLimits/{limitId} {
      allow read, write: if true;
    }

    // Admin Logs
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
