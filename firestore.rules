rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user is the admin (configured admin email)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'blessing.waydiva@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      // Regular users cannot modify their entitlement tier; only admin or server can
      allow update: if isAdmin() || (
        isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['entitlement']) ||
          request.resource.data.entitlement == resource.data.entitlement
        )
      );
      allow delete: if isOwner(userId) || isAdmin();

      // Subcollections under user
      match /favorites/{recipeId} {
        allow read, write: if isOwner(userId);
      }

      match /cookingHistory/{historyId} {
        allow read, write: if isOwner(userId);
      }

      match /passport/{countryCode} {
        allow read, write: if isOwner(userId);
      }

      match /shoppingList/{itemId} {
        allow read, write: if isOwner(userId);
      }

      match /downloads/{recipeId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Premium tester requests
    match /premiumRequests/{requestId} {
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Recipe insights (aggregated, anonymized)
    match /recipeInsights/{recipeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rate limits (tracking for serverless AI endpoints)
    match /rateLimits/{limitId} {
      allow read, write: if true;
    }

    // Admin logs
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
