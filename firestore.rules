rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'blessing.waydiva@gmail.com') ||
        request.auth.token.admin == true
      );
    }

    // Entitlements: Never writable by regular users.
    // Only backend Firebase Admin SDK or verified administrators can modify entitlements.
    match /entitlements/{docId} {
      allow read: if isOwner(docId) || isAdmin();
      allow write: if isAdmin();
    }

    // User profiles & cooking preferences:
    // Clients can never escalate their entitlement tier or grant themselves premium.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // On creation, entitlement must be free tier if provided
      allow create: if isOwner(userId) && (
        !('entitlement' in request.resource.data) ||
        request.resource.data.entitlement.tier == 'free' ||
        request.resource.data.entitlement.tier == 'FREE'
      );
      
      // On update, users can update preferences, cooking state, etc., but CANNOT modify entitlement or admin fields
      allow update: if isOwner(userId) && (
        isAdmin() ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['entitlement', 'isAdmin', 'role', 'admin'])
      );
      
      allow delete: if isOwner(userId) || isAdmin();

      // Explicitly scoped user subcollections
      match /favorites/{recipeId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /cookingHistory/{historyId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /shoppingLists/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /passport/{countryCode} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /preferences/{prefId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /personalization/{sigId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Payment Records: Managed and recorded exclusively by server-side verification
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // AI Quota & Fair-Use Tracking: Authoritative server-side transaction tracking
    match /aiUsage/{usageId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Premium Reviewer Requests:
    // Submitted via verified backend endpoint; users can only read their own request status.
    match /premiumRequests/{requestId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Recipe question insights (curated culinary knowledge & aggregate question analytics) - Admin only
    match /recipeInsights/{recipeId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Admin audit and error logs
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Explicitly lock down any deprecated /rateLimits path
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }
  }
}
