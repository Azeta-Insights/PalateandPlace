{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile, preferences, and personal cooking state",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "preferences": {
          "type": "object",
          "properties": {
            "dietary": { "type": "array", "items": { "type": "string" } },
            "allergies": { "type": "array", "items": { "type": "string" } },
            "favoriteIngredients": { "type": "array", "items": { "type": "string" } },
            "avoidIngredients": { "type": "array", "items": { "type": "string" } },
            "preferredCookingTime": { "type": "string" },
            "spicePreference": { "type": "string" }
          }
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Entitlement": {
      "title": "Entitlement",
      "description": "Server-authoritative tier and access grant record",
      "type": "object",
      "properties": {
        "tier": { "type": "string", "enum": ["FREE", "PREMIUM", "TEST_PREMIUM"] },
        "source": { "type": "string", "enum": ["default", "purchase", "test", "dev", "revoked"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "approvedAt": { "type": "string" },
        "approvedBy": { "type": "string" },
        "paymentReference": { "type": "string" }
      }
    },
    "Payment": {
      "title": "Payment Record",
      "description": "Verified transaction record from Paystack",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "paystackReference": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "verifiedAt": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "AiUsage": {
      "title": "AI Usage Record",
      "description": "Persistent atomic tracking for AI Chef fair-use limits",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "calendarMonth": { "type": "string" },
        "lastDay": { "type": "string" },
        "todayCount": { "type": "number" },
        "monthCount": { "type": "number" },
        "lastRequestAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "CookingRecord": {
      "title": "Cooking Record",
      "description": "Log of a prepared recipe with rating, notes, and optional photo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipeId": { "type": "string" },
        "recipeTitle": { "type": "string" },
        "country": { "type": "string" },
        "continent": { "type": "string" },
        "rating": { "type": "number" },
        "notes": { "type": "string" },
        "photoUrl": { "type": "string" },
        "cookedAt": { "type": "string" }
      }
    },
    "PremiumRequest": {
      "title": "Premium Access Request",
      "description": "Reviewer request for test access",
      "type": "object",
      "properties": {
        "requestId": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "requestedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "REVOKED"] },
        "reviewedAt": { "type": "string" },
        "reviewedBy": { "type": "string" }
      }
    },
    "RecipeInsight": {
      "title": "Recipe Insight",
      "description": "Aggregated culinary questions and common hurdles for recipes",
      "type": "object",
      "properties": {
        "recipeId": { "type": "string" },
        "recipeTitle": { "type": "string" },
        "totalQuestions": { "type": "number" },
        "questionCategories": { "type": "object" },
        "topQuestions": { "type": "array" },
        "lastUpdated": { "type": "string" }
      }
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "Root collection of users"
    },
    "entitlements": {
      "schema": "Entitlement",
      "description": "Server-authoritative user entitlement records"
    },
    "payments": {
      "schema": "Payment",
      "description": "Verified transaction records"
    },
    "aiUsage": {
      "schema": "AiUsage",
      "description": "Atomic quota tracking for AI Chef"
    },
    "premiumRequests": {
      "schema": "PremiumRequest",
      "description": "Root collection of test premium requests"
    },
    "recipeInsights": {
      "schema": "RecipeInsight",
      "description": "Aggregated question insights"
    }
  }
}
