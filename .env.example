# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYSTACK CONFIGURATION FOR VERCEL DEPLOYMENT
# 1. Public Key (starts with pk_live_... or pk_test_...)
# In Vercel, add BOTH VITE_PAYSTACK_PUBLIC_KEY and PAYSTACK_PUBLIC_KEY in Project Settings > Environment Variables
VITE_PAYSTACK_PUBLIC_KEY="pk_live_your_paystack_public_key_here"
PAYSTACK_PUBLIC_KEY="pk_live_your_paystack_public_key_here"

# 2. Secret Key (starts with sk_live_... or sk_test_...)
# In Vercel, add PAYSTACK_SECRET_KEY in Project Settings > Environment Variables (Server-side API route)
PAYSTACK_SECRET_KEY="sk_live_your_paystack_secret_key_here"

# Firebase Client Configuration
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
