# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYSTACK_PUBLIC_KEY: Public key from Paystack Dashboard (e.g., starts with pk_)
# Used to initialize the Paystack checkout popup on the frontend.
PAYSTACK_PUBLIC_KEY="YOUR_PAYSTACK_PUBLIC_KEY"

# PAYSTACK_SECRET_KEY: Secret key from Paystack Dashboard (e.g., starts with sk_)
# Used on the server to securely verify incoming transactions with Paystack's API.
PAYSTACK_SECRET_KEY="YOUR_PAYSTACK_SECRET_KEY"

# VITE_FIREBASE_API_KEY: Optional override for Firebase Web API Key
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"

